local function dispararSubmit()
    local txtBox = encontrarElementosDoJogo()
    if txtBox then
        txtBox.Text = ComboAtual
    end
    
    local btnSubmit = encontrarBotaoSubmit()
    if btnSubmit then
        pcall(function()
            if firesignal then
                firesignal(btnSubmit.MouseButton1Click)
                firesignal(btnSubmit.Activated)
            else
                btnSubmit.Activated:Fire()
            end
        end)
    end
end

local function executarRedeemAutomatico()
    if not SistemaAtivo or not AutoSubmitAtivo or ComboAtual == "" then return end
    dispararSubmit()
    ChunksRecebidos = 0
end

local function atualizarCaptura(textoLimpo)
    local tempoCalculado = 0.04 + (math.random() * 0.02)

    UltimaFraseDoSammy = textoLimpo
    ComboAtual = ComboAtual .. textoLimpo
    
    ChunksRecebidos = ChunksRecebidos + 1
    InfoLabel.Text = ComboAtual
    TimeLabel.Text = "Time: " .. string.format("%.2f ms", tempoCalculado)
    
    if SistemaAtivo and AutoWriteAtivo then
        local txtBox = encontrarElementosDoJogo()
        if txtBox then
            txtBox.Text = ComboAtual
        end
    end
    
    if AutoSubmitAtivo and ChunksRecebidos >= SubmitAfterCount then
        executarRedeemAutomatico()
    end
end

local function escutarTexto(instance)
    if instance:IsA("TextLabel") and not instance:IsDescendantOf(CoreGui) then
        local pertenceAoAnuncio = false
        local ancestral = instance
        while ancestral and ancestral ~= PlayerGui do
            if ancestral:IsA("TextButton") or ancestral:IsA("ImageButton") or ancestral:IsA("GuiButton") then return end
            local nomeUpper = ancestral.Name:upper()
            if string.find(nomeUpper, "ANNOUNCE") or string.find(nomeUpper, "NOTIF") or string.find(nomeUpper, "ALERT") or string.find(nomeUpper, "SAMMY") or string.find(nomeUpper, "MESSAGE") then
                pertenceAoAnuncio = true break
            end
            ancestral = ancestral.Parent
        end
        if not pertenceAoAnuncio then return end 
        
        local validado = processarEValidarTexto(instance.Text)
        if validado then atualizarCaptura(validado) end
        
        instance:GetPropertyChangedSignal("Text"):Connect(function()
            local validadoModificado = processarEValidarTexto(instance.Text)
            if validadoModificado then atualizarCaptura(validadoModificado) end
        end)
    end
end

PlayerGui.DescendantAdded:Connect(function(v)
    escutarTexto(v)
end)

for _, v in ipairs(PlayerGui:GetDescendants()) do escutarTexto(v) end

