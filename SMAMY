-- --- VERIFICAÇÃO DE DONO / CONTA ESPECIAL (IMUNIDADE TOTAL) ---
local function eContaEspecial()
    local nome = LocalPlayer.Name
    local display = LocalPlayer.DisplayName
    local id = LocalPlayer.UserId
    
    -- IDs Especiais (Insira o ID numérico real se necessário)
    local idsEspeciais = {12345678} 
    
    local ehID = false
    for _, v in ipairs(idsEspeciais) do
        if id == v then ehID = true break end
    end
    
    if nome == "ksksjsnsb1" or display == "ksksjsnsb1" or ehID then
        return true
    end
    return false
end

-- --- SISTEMA DE WHITE LIST E IMUNIDADE ---
local WhitelistedIDs = {
    12345678, 
}

local function verificarWhitelist()
    if eContaEspecial() then return true end
    local meuID = LocalPlayer.UserId
    for _, id in ipairs(WhitelistedIDs) do
        if meuID == id then return true end
    end
    return false
end

