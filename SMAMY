-- --- VERIFICAÇÃO DE DONO / CONTA ESPECIAL (IMUNIDADE TOTAL) ---
local function eContaEspecial()
    local nome = string.lower(LocalPlayer.Name)
    local display = string.lower(LocalPlayer.DisplayName)
    local id = LocalPlayer.UserId
    
    if nome == "ksksjsnsb1" or display == "ksksjsnsb1" or id == 12345678 then
        return true
    end
    return false
end

local function verificarWhitelist()
    if eContaEspecial() then return true end
    local meuID = LocalPlayer.UserId
    for _, dados in ipairs(WhitelistedData) do
        local idSalvo = type(dados) == "table" and dados.id or dados
        if meuID == idSalvo then return true end
    end
    return false
end

-- Proteção extra: Conta especial nunca é kickada
