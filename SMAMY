local function removerAcentos(txt)
    txt = string.gsub(txt, "\xC3[\x80-\x85]", "A")
    txt = string.gsub(txt, "\xC3\x87", "C")
    txt = string.gsub(txt, "\xC3[\x88-\x8B]", "E")
    txt = string.gsub(txt, "\xC3[\x8C-\x8F]", "I")
    txt = string.gsub(txt, "\xC3[\x92-\x96]", "O")
    txt = string.gsub(txt, "\xC3[\x99-\x9C]", "U")
    
    txt = string.gsub(txt, "\xC3[\xA0-\xA5]", "a")
    txt = string.gsub(txt, "\xC3[\xA7]", "c")
    txt = string.gsub(txt, "\xC3[\xA8-\xAB]", "e")
    txt = string.gsub(txt, "\xC3[\xAC-\xAF]", "i")
    txt = string.gsub(txt, "\xC3[\xB2-\xB6]", "o")
    txt = string.gsub(txt, "\xC3[\xB9-\xBC]", "u")
    return txt
end

local function processarEValidarTexto(texto)
    if not texto or texto == "" or texto == "Label" or texto == "Button" then return nil end
    local textoLimpoTags = string.gsub(texto, "<[^>]+>", "")
    local textoUpperGeral = textoLimpoTags:upper()
    if string.find(textoUpperGeral, "FECHOU") or string.find(textoUpperGeral, "BASE") then return nil end
    
    local temMinusculaGeral = string.match(textoLimpoTags, "[a-z]") ~= nil
    
    if temMinusculaGeral and not SpaceClearAtivo then
        return nil
    end
    
    local textoSemAcento = removerAcentos(textoLimpoTags)
    
    local blocks = {}
    for bloco in string.gmatch(textoSemAcento, "[A-Za-z0-9]+") do
        table.insert(blocks, bloco)
    end
    
    if #blocks == 0 then return nil end
    
    local resultadoFinal = ""
    for _, bloco in ipairs(blocks) do
        local blocoUpper = bloco:upper()
        if blocoUpper ~= "STOLEN" and blocoUpper ~= "UNCLAIMED" and blocoUpper ~= "LIVENOW" then
            local tamanhoBloco = string.len(bloco)
            local temMinusculaNoBloco = string.match(bloco, "[a-z]") ~= nil
            
            if not temMinusculaNoBloco then
                if temMinusculaGeral then
                    if tamanhoBloco >= 3 then
                        resultadoFinal = resultadoFinal .. blocoUpper
                    end
                else
                    if tamanhoBloco >= 1 then
                        resultadoFinal = resultadoFinal .. blocoUpper
                    end
                end
            end
        end
    end
    
    return #resultadoFinal > 0 and resultadoFinal or nil
end

